{
  "name": "ESP32-S3 DevKitC-1 N16R8 (16 MB QIO flash, 8 MB OPI PSRAM)",
  "vendor": "Espressif",
  "url": "https://docs.espressif.com/projects/esp-idf/en/v5.2.1/esp32s3/hw-reference/esp32s3/user-guide-devkitc-1.html",
  "frameworks": ["arduino"],
  "connectivity": ["wifi", "bluetooth"],
  "build": {
    "core": "esp32",
    "mcu": "esp32s3",
    "variant": "esp32s3",
    "f_cpu": "240000000L",
    "f_flash": "80000000L",
    "flash_mode": "qio",
    "psram_type": "opi",
    "arduino": {
      "memory_type": "qio_opi",
      "partitions": "default_16MB.csv"
    },
    "extra_flags": [
      "-DARDUINO_ESP32S3_DEV",
      "-DARDUINO_USB_MODE=1",
      "-DARDUINO_RUNNING_CORE=1",
      "-DARDUINO_EVENT_RUNNING_CORE=1",
      "-DBOARD_HAS_PSRAM"
    ]
  },
  "upload": {
    "flash_size": "16MB",
    "maximum_size": 16777216,
    "maximum_ram_size": 327680,
    "require_upload_port": true,
    "speed": 115200
  }
}
